generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoUsuario {
  SERVIDOR_UERN
  FORNECEDOR_EXTERNO
}

enum StatusUsuario {
  PENDENTE_APROVACAO
  DEVOLVIDO_CORRECAO
  ATIVO
  BLOQUEADO
}

model UnidadeCentral {
  id           String           @id @default(uuid())
  codigo       String?          @unique
  sigla        String           @unique // Ex: "PROAD", "FAFIC", "DINF", "CAMPUS-ASSU"
  nome         String           // Nome por extenso
  campus       String           // Mossoró, Assú, Caicó, Patu, Pau dos Ferros, Natal
  email        String?
  telefone     String?
  predioNome   String?          // Ex: "Bloco Central", "Reitoria", "Complexo Cultural"
  ativo        Boolean          @default(true)
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  usuarios     UsuarioCentral[]

  @@map("portal_unidades")
}

model UsuarioCentral {
  id              String          @id @default(uuid())
  tipoUsuario     TipoUsuario     @default(SERVIDOR_UERN)
  status          StatusUsuario   @default(PENDENTE_APROVACAO)

  // Dados Pessoais / Conta
  nome            String
  email           String          @unique // Servidor: restrito a @uern.br; Fornecedor: corporativo
  cpf             String          @unique // Validação real de dígitos verificadores
  senhaHash       String?         // Hash bcrypt (obrigatório para fornecedor / senha mestre)
  fotoUrl         String?
  telefone        String?

  // Exclusivo: Servidor UERN
  matricula       String?         // Formato padronizado: xxxxxx-x
  unidadeId       String?
  unidade         UnidadeCentral? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)

  // Exclusivo: Fornecedor / Empresa Externa
  cnpjEmpresa     String?         // CNPJ da empresa com validação de dígitos
  razaoSocial     String?
  nomeFantasia    String?
  cargoPreposto   String?

  // Matriz de Governança: Perfis específicos por Sistema
  perfilSgc       String?         // ADMIN_PROAD, GESTOR, FISCAL_ADM, FISCAL_TECNICO, FISCAL_SETORIAL, GESTOR_ATA, FORNECEDOR
  perfilManut     String?         // ADMIN, GESTOR_CONTRATO, FISCAL_ADM, FISCAL_TECNICO, FISCAL_SETORIAL, GESTOR_UNIDADE, DEMANDANTE, EMPRESA, TECNICO_SOBE
  perfilPca       String?         // ADMIN, UNIDADE
  permissoesPca   Json?           // Subpermissões finas de DFD ({ podeCriarDfd, podeEnviarDfd, etc })
  perfilDiarias   String?         // ADMIN, DEMANDANTE, FISCAL, APROVADOR

  // Auditoria e Controle de Acesso
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt
  aprovadoEm      DateTime?
  aprovadoPor     String?         // E-mail do Administrador que aprovou
  motivoBloqueio  String?
  motivoDevolucao String?         // Mensagem do administrador orientando correção
  dataDevolucao   DateTime?       // Data em que foi devolvido para ajuste

  logs            LogAuditoriaCentral[]

  @@map("portal_usuarios")
}

model LogAuditoriaCentral {
  id              String          @id @default(uuid())
  sistema         String          @default("PORTAL") // PORTAL, SGC, PCA, MANUTENCAO, DIARIAS
  acao            String          // CRIACAO, EDICAO, EXCLUSAO, ADITIVO, MEDICAO, HOMOLOGACAO, etc.
  entidade        String?         // Contrato, Ata, Dfd, OrdemServico, Diaria, UsuarioCentral, etc.
  entidadeId      String?
  entidadeNome    String?         // Ex: "Contrato nº 12/2026", "OS nº 45/2026"
  descricao       String          @default("") // Descrição textual amigável do evento

  // QUEM (Dados de quem executou a ação)
  usuarioId       String?
  usuario         UsuarioCentral? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNome     String?
  usuarioEmail    String
  usuarioRole     String?
  unidadeSigla    String?

  // O QUE MUDOU (Diff detalhado para conferência de divergências)
  dadosAnteriores Json?           // Snapshot antes da alteração
  dadosNovos      Json?           // Snapshot após a alteração
  camposAlterados String[]        // Lista de campos que divergiram
  detalhes        Json?           // Detalhes adicionais legados ou metadados extras

  // ONDE (Rastreabilidade técnica)
  ip              String?
  userAgent       String?
  rota            String?

  // QUANDO
  criadoEm        DateTime        @default(now())

  @@index([sistema])
  @@index([acao])
  @@index([entidade, entidadeId])
  @@index([usuarioEmail])
  @@index([criadoEm])
  @@map("portal_logs_auditoria")
}
