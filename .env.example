# Banco de Dados Neon PostgreSQL com schema dedicado 'portal'
DATABASE_URL="postgresql://usuario:senha@host-pooler.sa-east-1.aws.neon.tech/neondb?schema=portal&sslmode=require&channel_binding=require&pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host.sa-east-1.aws.neon.tech/neondb?schema=portal&sslmode=require"

# Segredos de Autenticação & SSO
JWT_SECRET="sua_chave_mestra_sso_portal_proad"
PROAD_SERVICE_KEY="sua_chave_de_servico_interoperabilidade"

# URLs dos Sistemas Integrados (Produção Vercel)
NEXT_PUBLIC_PORTAL_URL="https://portal-proad.vercel.app"
NEXT_PUBLIC_SGC_URL="https://sgc-uern.vercel.app"
SGC_URL="https://sgc-uern.vercel.app"
NEXT_PUBLIC_PCA_URL="https://pca-uern.vercel.app"
PCA_URL="https://pca-uern.vercel.app"
NEXT_PUBLIC_MANUTENCAO_URL="https://manutencao-uern.vercel.app"
MANUTENCAO_URL="https://manutencao-uern.vercel.app"
NEXT_PUBLIC_DIARIAS_URL="https://diarias-proaduern.vercel.app"
